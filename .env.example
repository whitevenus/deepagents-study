# 复制为 .env 并填入你的 key(.env 已被 .gitignore 忽略,不会提交)
# 拷贝命令:  cp .env.example .env

# ---- 模型(三选一)----
# 方案A:硅基流动(课程默认,有免费模型,先跑通用这个)注册:https://siliconflow.cn
SILICONFLOW_API_KEY=
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 方案B:OpenAI 官方(你已装 langchain-openai)
# OPENAI_API_KEY=

# 方案C:Anthropic / Claude 官方
# ANTHROPIC_API_KEY=

# 选用哪个 provider:siliconflow | openai | anthropic
LLM_PROVIDER=siliconflow

# ---- 联网搜索工具 ----
# 注册:https://tavily.com (有免费额度)
TAVILY_API_KEY=

# ---- 可观测/审计(Phase 5)· Langfuse 自托管 ----
# 起可观测栈:docker compose --profile observability up -d  (UI http://localhost:3000)
# 这三个由后端 agent 客户端用,把 agent 轨迹送进 Langfuse;留空则全程 no-op(不影响任务执行)。
# key 与 docker-compose.langfuse.yml 里 INIT 的那对一致,无需手动复制。
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-autoboard-local
LANGFUSE_SECRET_KEY=sk-lf-autoboard-local
# 禁用 LangSmith 云(数据出境):本项目可观测一律自托管 Langfuse。

# ---- 认证(Phase 3.5)----
# JWT 签名密钥:开发有默认值;生产必须设强随机值(≥32 字节),如 `openssl rand -hex 32`
# JWT_SECRET=
# JWT_EXPIRE_HOURS=12

# ---- 数据库 + 知识库(Phase 4)----
# 本地用 docker-compose 起的 Postgres+pgvector(docker compose up -d)
DATABASE_URL=postgresql+psycopg://autoboard:autoboard@127.0.0.1:5432/autoboard
# embedding 模型(维度须与 EMBED_DIM 一致;Qwen3-Embedding-4B=2560)
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
EMBED_DIM=2560
